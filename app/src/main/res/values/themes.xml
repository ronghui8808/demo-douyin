<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.Douyin" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/douyin_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.Douyin" parent="Base.Theme.Douyin" />

    <style name="Theme.Douyin.Splash" parent="Theme.Douyin">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="Theme.Douyin.Camera" parent="Theme.Douyin">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="Widget.Douyin.BottomNavigation" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/bottom_nav_bg</item>
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.Douyin.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/douyin_text_input_stroke</item>
        <item name="hintTextColor">@color/douyin_gray</item>
        <item name="android:textColorHint">@color/douyin_gray</item>
    </style>

</resources>
