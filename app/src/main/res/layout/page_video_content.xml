<?xml version="1.0" encoding="utf-8"?>
<com.example.douyin.widget.ProfileSwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_swipe_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:clipChildren="true">

    <FrameLayout
        android:id="@+id/video_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="true">

        <TextureView
            android:id="@+id/texture_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

    </FrameLayout>

    <include
        android:id="@+id/overlay"
        layout="@layout/view_video_overlay" />

    <ImageView
        android:id="@+id/iv_pause_indicator"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center"
        android:contentDescription="@string/video_paused_indicator"
        android:src="@drawable/ic_video_paused"
        android:visibility="gone"
        tools:visibility="visible" />

    <ImageView
        android:id="@+id/iv_double_tap_like"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:contentDescription="@string/action_like"
        android:src="@drawable/ic_like_active"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progress_buffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/white"
        android:visibility="gone" />

</com.example.douyin.widget.ProfileSwipeLayout>
